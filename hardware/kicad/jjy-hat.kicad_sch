  (symbol (lib_id "power:GND") (at 381.00 132.08 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "53e89477-abd6-5587-8d37-dfc9603e40cd") (property "Reference" "#PWR29" (at 381.00 132.08 0) (effects (font (size 1.27 1.27)) hide)) (property "Value" "GND" (at 383.54 132.08 0) (effects (font (size 1.27 1.27)) hide)) (property "Footprint" "" (at 381.00 132.08 0) (effects (font (size 1.27 1.27)) hide)) (property "Datasheet" "" (at 381.00 132.08 0) (effects (font (size 1.27 1.27)) hide)) (pin "1" (uuid "5cfbf608-453e-5e7f-991f-6c2c3525d0ae")) (instances (project "jjy-hat" (path "/40741956-28cf-5098-b1ad-9fedd8f61b8d" (reference "#PWR29") (unit 1)))))
  (text "JJY HAT 40/60kHz (60kHz Hagane-yama default / 40kHz Ohtakadoya-yama), on-board RTC" (exclude_from_sim no) (at 20 25 0) (effects (font (size 3.5 3.5)) (justify left)) (uuid "047a1087-ee7d-55a2-8625-0121de22e1fe"))
  (text "GPIO18 (PWM0) = 40k/60kHz carrier. GPIO23 = level: Low -> U1B enabled -> full amplitude / High -> 10% (-20dB)." (exclude_from_sim no) (at 20 35 0) (effects (font (size 2.0 2.0)) (justify left)) (uuid "93d1500e-9e29-5161-a5d6-e9a782db1e33"))
  (text "U1A (always on) drives via R1 1k, U1B adds R2 100R in parallel: (1k+Rcoil)/(91R+Rcoil) = ~10:1." (exclude_from_sim no) (at 20 41 0) (effects (font (size 2.0 2.0)) (justify left)) (uuid "4386525f-7d0b-5740-b34e-0585fc35daa3"))
  (text "Series resonance: L(1mH) with C2+C3+C4 (+C5 trim) = 7.05nF -> 59.9kHz; with C7+C8+C9 (+9.1nF) = 16.15nF -> 39.6kHz. Measure L and tune C." (exclude_from_sim no) (at 20 47 0) (effects (font (size 2.0 2.0)) (justify left)) (uuid "18e9341a-89f8-553a-8540-9606aff880d2"))
  (text "U2 DS3231SN + BT1 CR2032: on-board RTC (I2C pull-ups are on the Pi). Enable [rtc] in /etc/jjyd.toml." (exclude_from_sim no) (at 20 59 0) (effects (font (size 2.0 2.0)) (justify left)) (uuid "358b466f-df00-5730-976d-ec98209db37a"))
  (text "Band select: GPIO26 (FSEL). Low = 60kHz (default). High = K1 photo-MOS relay adds C7-C9 (9.1nF) -> 40kHz." (exclude_from_sim no) (at 20 65 0) (effects (font (size 2.0 2.0)) (justify left)) (uuid "92c3ea82-7377-5d52-b1a3-c79d4e82b25f"))
  (text "Keep the radiated field within the micro-power station limit (500uV/m at 3m, below 322MHz)." (exclude_from_sim no) (at 20 53 0) (effects (font (size 2.0 2.0)) (justify left)) (uuid "6039003d-6a70-50a2-a203-77eb89b753f1"))
  (sheet_instances (path "/" (page "1")))
