  (symbol (lib_id "power:GND") (at 279.40 184.15 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "1b638627-678c-5d45-a7ba-99c77276cb5a") (property "Reference" "#PWR35" (at 279.40 184.15 0) (effects (font (size 1.27 1.27)) hide)) (property "Value" "GND" (at 281.94 184.15 0) (effects (font (size 1.27 1.27)) hide)) (property "Footprint" "" (at 279.40 184.15 0) (effects (font (size 1.27 1.27)) hide)) (property "Datasheet" "" (at 279.40 184.15 0) (effects (font (size 1.27 1.27)) hide)) (pin "1" (uuid "b7bb253c-b38e-5435-aca3-288b8849416f")) (instances (project "jjy-hat" (path "/40741956-28cf-5098-b1ad-9fedd8f61b8d" (reference "#PWR35") (unit 1)))))
  (text "JJY time unit 40/60kHz: connects to the Raspberry Pi 2x20 GPIO header with a ribbon or Dupont cable (J1, top centre)." (exclude_from_sim no) (at 20 25 0) (effects (font (size 3.5 3.5)) (justify left)) (uuid "67ee80a1-6cd7-5665-8a90-4b5e5e0bfa01"))
  (text "GPIO18 (PWM0) = 40k/60kHz carrier. GPIO23 = level: Low -> U1B enabled -> full amplitude / High -> 10% (-20dB)." (exclude_from_sim no) (at 20 35 0) (effects (font (size 2.0 2.0)) (justify left)) (uuid "36ecff18-75ec-56d4-b1c0-58077fa9a6fb"))
  (text "U1A (always on) drives via R1 10k, U1B adds R2 1.1k in parallel: ratio = 1+R1/R2 = ~10:1 (-20dB). Keep R1 = ~9 x R2. Antenna current ~2mA." (exclude_from_sim no) (at 20 41 0) (effects (font (size 2.0 2.0)) (justify left)) (uuid "bdf85c54-36ba-5fa0-a693-8cba774bd472"))
  (text "L1 = on-board PCB spiral coil (2 layers, ~15uH, DC resistance ~4 ohm). Not resonant: the drive resistance is much larger than the coil reactance." (exclude_from_sim no) (at 20 47 0) (effects (font (size 2.0 2.0)) (justify left)) (uuid "9e77531d-a522-587a-a8f5-58ee9762525a"))
  (text "U2 DS3231SN + BT1 CR2032: on-board RTC (I2C pull-ups are on the Pi). J3 = I2C 16x2 LCD. D2 = signal LED (GPIO24)." (exclude_from_sim no) (at 20 53 0) (effects (font (size 2.0 2.0)) (justify left)) (uuid "a68dfd24-09b0-50dd-bc26-269177ffb5d5"))
  (text "Keep the radiated field within the micro-power station limit (500uV/m at 3m, below 322MHz)." (exclude_from_sim no) (at 20 59 0) (effects (font (size 2.0 2.0)) (justify left)) (uuid "bd2e9768-75f5-5637-b7df-384fde6fa03d"))
  (sheet_instances (path "/" (page "1")))
)
