[Unit]
Description=JJY time code transmitter
After=chrony.service
Wants=chrony.service

[Service]
Type=simple
Environment=PYTHONPATH=/opt/timeserver/server
ExecStart=/usr/bin/python3 -m jjyd -c /etc/jjyd.toml
Restart=always
RestartSec=5
# sysfs PWM と GPIO を操作するため root。ホームや他のFSは読み取り専用に。
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/sys/class/pwm
LimitRTPRIO=50
StateDirectory=jjyd
# lgpio(gpiozero)は作業ディレクトリに通知用のパイプを作る。ProtectSystem=strict では / に書けないので、書ける所を指定する。
WorkingDirectory=/var/lib/jjyd

[Install]
WantedBy=multi-user.target
